{
  "name": "linkedin-company-url-verifier",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "sample": "npm run sample --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
